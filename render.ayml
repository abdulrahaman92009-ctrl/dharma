
databases:
  - name: humanity-connect-db
    databaseName: humanity_connect
    user: humanity_connect_user
    plan: basic-256mb

services:
  - type: web
    name: humanity-connect-api
    runtime: node
    rootDir: backend
    buildCommand: npm install
    startCommand: npm start
    healthCheckPath: /api/health
    envVars:
      - key: NODE_ENV
        value: production
      - key: DATABASE_URL
        fromDatabase:
          name: humanity-connect-db
          property: connectionString
      - key: JWT_SECRET
        generateValue: true
      - key: FRONTEND_URL
        sync: false
      - key: PGSSL
        value: "true"
      - key: NEXCONN_APP_KEY
        sync: false
      - key: NEXCONN_APP_SECRET
        sync: false
      - key: NEXCONN_PRIMARY_API_DOMAIN
        sync: false
      - key: NEXCONN_SECONDARY_API_DOMAIN
        sync: false

  - type: web
    name: humanity-connect
    runtime: static
    rootDir: frontend
    buildCommand: npm install && npm run build
    staticPublishPath: dist
    envVars:
      - key: VITE_API_URL
        value: https://humanity-connect-api.onrender.com
